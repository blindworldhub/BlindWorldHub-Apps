<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: a shared link (text) can go straight to Smart Downloader from the top of the share screen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.blindworldhub.smartdownloader.MainActivity">
        <data android:mimeType="text/plain" />
        <category android:name="com.blindworldhub.smartdownloader.category.DOWNLOAD" />
    </share-target>
</shortcuts>
